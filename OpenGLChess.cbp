	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="OpenGLChess" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/OpenGLChess" prefix_auto="1" extension_auto="1" />
