				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="-lGLEW -lglfw3 -lGL -lX11 -lXrandr -lXinerama -lXi -lXxf86vm -ldl -lpthread" />
				</Linker>
			</Target>
			<Target title="Release">
